{
  "expo": {
    "name": "AI LEGAL™",
    "slug": "ai-legal",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icons/adaptive-icon.png",
    "scheme": [
      "ailegal",
      "ailegalmobile",
      "com.googleusercontent.apps.743928421487-8nuhql6qpu3c3vd4tum9g5a4c0qkcgdj"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/icons/adaptive-icon.png",
      "bundleIdentifier": "com.uwo.ailegal",
      "buildNumber": "21",
      "supportsTablet": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSCameraUsageDescription": "AI LEGAL™ uses camera access to capture documents, evidence, and images for analysis.",
        "NSPhotoLibraryUsageDescription": "AI LEGAL™ uses photo access to select documents and images for analysis.",
        "NSMicrophoneUsageDescription": "AI LEGAL™ uses microphone access for voice input and AI voice-based features.",
        "NSLocationWhenInUseUsageDescription": "AI Legal requires location access to find nearby advocates and legal services.",
        "NSFaceIDUsageDescription": "AI Legal requires Face ID for quick and secure biometric login.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.uwo.ailegal",
      "largeHeap": true,
      "googleServicesFile": "./google-services.json",
      "versionCode": 514,
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/icons/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ailegal"
            },
            {
              "scheme": "ailegalmobile"
            },
            {
              "scheme": "https",
              "host": "aisa.uwo24.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "uwo24.com",
              "pathPrefix": "/app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icons/inapplogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/icons/new one spalsh screen.png",
          "resizeMode": "contain",
          "android": {
            "image": "./assets/icons/new one spalsh screen.png",
            "imageWidth": 180,
            "resizeMode": "contain"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/adaptive-icon.png",
          "color": "#6D5DFC"
        }
      ],
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      "./plugins/withAndroidOrientationFix.js",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.1.20",
            "enableProguardInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.facebook.react.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.facebook.soloader.** { *; }\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class expo.modules.** { *; }\n-keep class com.google.mlkit.** { *; }\n-keep class com.google.android.gms.** { *; }\n-keepattributes *Annotation*\n-keepattributes Signature\n-keepattributes InnerClasses"
          },
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da420927-c698-45b3-8916-e3cfd231b37b"
      }
    },
    "owner": "abha0518"
  }
}
