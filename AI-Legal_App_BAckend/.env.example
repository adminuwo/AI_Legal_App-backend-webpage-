# Backend Environment Configuration Template (DO NOT COMMIT REAL SECRETS)

# Application Environment
NODE_ENV=development
PORT=8080
API_PREFIX=/api

# Database Configuration
MONGODB_ATLAS_URI=mongodb://localhost:27017/ai_legal_db
MONGO_URI=mongodb://localhost:27017/ai_legal_db

# Authentication / JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=30d

# Initial Admin Provisioning (Optional - set only on first deployment)
# INITIAL_ADMIN_EMAIL=admin@yourdomain.com
# INITIAL_ADMIN_PASSWORD=change_this_secure_password_123!

# Storage & Third-Party APIs
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=

# Mobile & CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
