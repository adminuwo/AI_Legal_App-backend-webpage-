# Backend Environment Configuration Template (DO NOT COMMIT SENSITIVE SECRETS)

# Application Environment
NODE_ENV=development
PORT=8080
APP_NAME=AI-Legal
APP_DEFAULT_LANGUAGE=English

# MongoDB Database Configuration
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/AISA
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/AISA
DB_NAME=AISA

# Authentication / JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
TOKEN_EX=30d

# Google Cloud Platform & Vertex RAG
GCP_PROJECT_ID=ai-mall-484810
GCP_LOCATION=asia-south1
VERTEX_RAG_CORPUS_ID=1152921504606846976
GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-key.json
VIDEO_SERVICE_ACCOUNT=

# Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI / AI Services
OPENAI_API_KEY=sk-...

# Search & Research APIs
TAVILY_API_KEY=tvly-...

# Cloudinary (Media / Document Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Services (Resend & SMTP)
RESEND_API_KEY=re_...
EMAIL=verification@ai-mall.in
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@example.com
EMAIL_HOST_PASSWORD=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=live

# Google Play In-App Purchase Service Account JSON
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY='{}'

# Frontend & CORS Origins
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
