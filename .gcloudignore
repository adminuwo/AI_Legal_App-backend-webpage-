# gcloud ignore file for Cloud Run and Cloud Build
.gcloudignore
.git
.gitignore

# Ignore node_modules across all subdirectories
**/node_modules/
node_modules/

# Ignore local builds and logs
**/dist/
**/build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore environment and secret files
**/.env
**/.env.*
!**/.env.example

# OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Scratch and archives
**/scratch/
**/archive/
qr code/
